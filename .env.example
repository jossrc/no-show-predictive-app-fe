# Copiar a .env.local (no versionado). Variables exclusivas del servidor Next.js:
# nunca usar el prefijo NEXT_PUBLIC_.

# Entorno de presentación
# development: interfaz de producto + acceso discreto a «Diagnóstico» técnico.
# production: solo información de negocio. Valor ausente o inválido = production.
# No sustituye a NODE_ENV ni habilita LIVE en un despliegue de producción.
APP_ENV=development

# Origen de datos
# live: datos reales (solo desarrollo local en 127.0.0.1; rechazado en producción sin HU-21/HU-22).
# mock: respuestas sintéticas deterministas exclusivamente para pruebas.
FRONTEND_DATA_MODE=live

# Backend Fastify (exclusivo del servidor)
# Clave interna ORIGINAL de Fastify (no el hash INTERNAL_API_KEY_SHA256 del backend).
FASTIFY_API_BASE_URL=http://127.0.0.1:3000
FASTIFY_INTERNAL_API_KEY=
